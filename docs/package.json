    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.7",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "docs-lib": "workspace:*",
