data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Just :: a -> Main.Maybe a
  | Nothing :: Main.Maybe a

recover :: forall a. a -> Main.Maybe a -> a
recover = \@a -> \fallback -> \input ->
  | (Just value) <- input -> value
  | true -> fallback
