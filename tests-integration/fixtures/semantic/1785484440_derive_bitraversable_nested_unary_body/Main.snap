      (Wrap field0 field1) -> foldr @f {foldableDict} @a @c
        (\element accumulator -> firstFunction element accumulator)
        (foldr @g {foldableDict1} @b @c (\element accumulator -> secondFunction element accumulator)
          accumulator
          field1)
