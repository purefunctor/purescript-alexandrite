data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Just :: a -> Main.Maybe a
  | Nothing :: Main.Maybe a

fromMaybe :: forall a. a -> Main.Maybe a -> a
fromMaybe = \@a -> \fallback -> \whole@(Just value) -> value
fromMaybe = \@a -> \fallback -> \Nothing -> fallback
