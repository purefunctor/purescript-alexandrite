data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Just :: a -> Main.Maybe a
  | Nothing :: Main.Maybe a

fromMaybe :: forall t0. t0 -> Main.Maybe t0 -> t0
fromMaybe = \@t0 -> \default -> \(Just value) -> value
fromMaybe = \@t0 -> \default -> \Nothing -> default
