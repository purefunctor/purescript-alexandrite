  foldr :: forall (a :: Prim.Type) (b :: Prim.Type). (a -> b -> b) -> b -> Main.RightNested @Prim.Type p a -> b
  foldr = \function accumulator value ->
    case value of
      (RightNested field0) -> foldr @(p Prim.Int) {foldableDict} @a @b
