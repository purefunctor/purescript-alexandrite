data Compose ::
  forall (k0 :: Prim.Type) (k1 :: Prim.Type). (k0 -> Prim.Type) -> (k1 -> k0) -> k1 -> Prim.Type
data Compose @f @g @a
  | Compose :: f (g a) -> Main.Compose f g a

dictionary foldableCompose ::
  forall f g.
  { foldableDict :: Data.Foldable.Foldable f } =>
  { foldableDict1 :: Data.Foldable.Foldable g } =>
  Data.Foldable.Foldable (Main.Compose @Prim.Type @Prim.Type f g)
  where
  foldr :: forall (a :: Prim.Type) (b :: Prim.Type).
  (a -> b -> b) -> b -> Main.Compose @Prim.Type @Prim.Type f g a -> b
  foldr = \@a -> \@b ->
    \function accumulator value ->
      case value of
        (Compose field0) -> foldr {foldableDict}
          (\element accumulator ->
            foldr {foldableDict1} (\element accumulator -> function element accumulator) accumulator
              element)
          accumulator
          field0
  foldl :: forall (a :: Prim.Type) (b :: Prim.Type).
  (b -> a -> b) -> b -> Main.Compose @Prim.Type @Prim.Type f g a -> b
  foldl = \@a -> \@b ->
    \function accumulator value ->
      case value of
        (Compose field0) -> foldl {foldableDict}
          (\accumulator element ->
            foldl {foldableDict1} (\accumulator element -> function accumulator element) accumulator
              element)
          accumulator
          field0
  foldMap :: forall (a :: Prim.Type) (m :: Prim.Type).
  Data.Monoid.Monoid m => (a -> m) -> Main.Compose @Prim.Type @Prim.Type f g a -> m
  foldMap = \@a -> \@m -> \{monoidDict} ->
    \function value ->
      case value of
        (Compose field0) -> foldMap {foldableDict} {monoidDict}
          (\element -> foldMap {foldableDict1} {monoidDict} (\element -> function element) element)
          field0
