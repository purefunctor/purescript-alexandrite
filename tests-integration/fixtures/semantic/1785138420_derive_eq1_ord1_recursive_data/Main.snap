dictionary ordTree :: forall t0. { ordDict :: Data.Ord.Ord t0 } => Data.Ord.Ord (Main.Tree t0) where
  superclass eqDict = eqTree {ordDict.eqDict}
  compare :: Main.Tree t0 -> Main.Tree t0 -> Data.Ordering.Ordering
  compare = \left right ->
