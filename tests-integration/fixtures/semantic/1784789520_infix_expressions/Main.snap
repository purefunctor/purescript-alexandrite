choose :: forall a b. a -> b -> a
choose = \@a -> \@b -> \left -> \right -> left

singleInfix :: Prim.Int
singleInfix = choose 1 "text"

multipleInfix :: Prim.Int
multipleInfix = choose (choose 1 "first") true

identity :: forall a. a -> a
identity = \@a -> \value -> value

polymorphicHead :: forall t0. t0 -> t0
polymorphicHead = \@t0 -> choose identity 1
