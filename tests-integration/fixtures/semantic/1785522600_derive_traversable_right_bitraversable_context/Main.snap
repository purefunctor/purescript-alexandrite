  foldl = \@a -> \@b -> \function -> \initial -> \(RightNested value) ->
    bifoldl @p {bifoldableDict} @Prim.Int @a @b (\accumulated _ -> accumulated) function initial
      value
  foldMap :: forall (a :: Prim.Type) (m :: Prim.Type).
