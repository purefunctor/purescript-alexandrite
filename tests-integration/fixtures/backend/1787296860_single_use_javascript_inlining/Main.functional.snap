@export inlineProperty = \record%2 -> identity record%2.value

@export inlineLiteral = \condition%3 ->
  if condition%3 then true else false

@export inlineClosure = \value%5 -> (\item%4 -> item%4) value%5

@export inlineCall = \function%6 value%7 -> function%6 value%7

