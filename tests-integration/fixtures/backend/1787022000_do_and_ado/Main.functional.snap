@export foreign firstAction

@export foreign secondAction

@export foreign independentAction

@export sequential = bind bindEffect1 firstAction (\first%0 -> secondAction first%0)

@export independent = apply applyEffect1
  (map functorEffect (\first%1 second%2 -> { first: first%1, second: second%2 }) firstAction)
  independentAction

@export pureValue = pure applicativeEffect 42
