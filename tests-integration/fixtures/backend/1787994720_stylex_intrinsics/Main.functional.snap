@export animation = stylex.keyframes { from: { opacity: 0.0 }, to: { opacity: 1.0 } }

@export styles = stylex.create {
  button: { color: "red", padding: 8, animationName: animation, ":hover": { color: "blue" } },
  label: { fontWeight: 600 }
}

@export secondary = stylex.create { root: { backgroundColor: "navy" } }

@export buttonProps = stylex.props styles.button

@export buttonPropsArray = \highlighted%0 ->
  stylex.props [styles.button, stylex.conditional highlighted%0 secondary.root]

@export buttonClassName = buttonProps.className
